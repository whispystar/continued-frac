import matplotlib.pyplot as plt
from fractions import Fraction
import numpy as np
import math
def draw_geodesic_sqrt(x1, x2, color="black", lw=1): #Function that plots and draws all the geodesics
    x1, x2 = float(x1), float(x2)
    center = (x1 + x2) / 2
    radius = abs(x2 - x1) / 2
    xs = np.linspace(x1, x2, 1000)
    ys = np.sqrt(np.clip(radius**2 - (xs - center)**2, 0, None))
    plt.plot(xs, ys, color=color, lw=lw)
    
    
def draw_farey_tessellation(seq):
    unique = set()
    for i in range(len(seq)):
        for j in range(i + 1, len(seq)):
            a, b = seq[i], seq[j]
            if abs(a.numerator * b.denominator - b.numerator * a.denominator) == 1: # determinant ad - bc = 1
                pair = tuple(sorted([a, b]))
                if pair not in unique:
                    draw_geodesic_sqrt(a, b)
                    unique.add(pair)
k = 3 #Row of the farey fractions we're plotting
a = -1 #Left Bound of the graph
