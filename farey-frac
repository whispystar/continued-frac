plt.figure(figsize=(15, 10))
plt.ylim(0, 2)
plt.xlim(float(a) - 0.002, float(b) + 0.002)
sequence = [Fraction(a), Fraction(b)]

# Adds all intergers between a-b to the sequence
for i in range(a,b):
    if Fraction(i) not in sequence:
        sequence.append(Fraction(i))
        sequence.sort()
#This loop generates the farey fraction to the kth row
for i in range(k):
    array = []
    for i in range(len(sequence)-1):
      a, b = sequence[i], sequence[i + 1]
      neighbor = Fraction(a.numerator + b.numerator, a.denominator + b.denominator) #Fraction(a+b / c+d)
      array.append(a)
      array.append(neighbor)
    array.append(sequence[-1])
    sequence = array

draw_farey_tessellation(sequence)
